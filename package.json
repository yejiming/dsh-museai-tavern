{
  "name": "@yejiming/dsh-museai-tavern",
  "description": "MuseAI tavern for the dsh web GUI: a MuseAI conversation-view tab (right of Trajectory) with background / chat / adventure / bond / settings pages ported from MuseAI, running entirely on models configured in DeepSeek Harness (no separate API config)",
  "version": "0.0.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yejiming/dsh-museai-tavern.git"
  },
  "bugs": {
    "url": "https://github.com/yejiming/dsh-museai-tavern/issues"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./routes": {
      "types": "./lib/types/routes.d.ts",
      "default": "./lib/routes.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "rm -rf lib && tsdown",
    "watch": "tsdown --watch",
    "build": "rm -rf lib && tsdown && tsc -p tsconfig.build.json && tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-invariants": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.2.3",
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.1",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.2.0-rc.1",
    "@types/node": "^25.0.0",
    "@types/react": "~18.3.1",
    "antd": "^6.4.3",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0",
    "zustand": "^5.0.13"
  }
}
